---
import '@fontsource/golos-text/cyrillic-400.css';
import '@fontsource/golos-text/cyrillic-600.css';
import '@fontsource/golos-text/latin-400.css';
import '@fontsource/golos-text/latin-600.css';
import '@fontsource/fira-sans-condensed/cyrillic-600.css';
import '@fontsource/fira-sans-condensed/latin-600.css';
import '@fontsource/fira-sans-condensed/cyrillic-700.css';
import '@fontsource/fira-sans-condensed/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { u } from '../lib/url';

interface Props { title: string; description?: string; active?: string }
const { title, description = 'Железобетонные изделия от производителя в Воронеже с 1956 года: фундаменты, плиты, лестницы, колодцы, каркас 1.020-1/87.', active } = Astro.props;
const full = title.includes('ЖБИ-2') ? title : `${title} — Завод ЖБИ-2, Воронеж`;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <!-- Демо-версия: не индексировать, чтобы не конкурировать с действующим сайтом -->
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#23292d" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
</head>
<body>
  <a class="visually-hidden" href="#main">К содержанию</a>
  <div class="concept-bar">
    <div class="wrap">
      <span>Концепт нового сайта gbi2.ru. Данные взяты с действующего сайта, тексты переписаны.</span>
      <a href={u('concept/')}>Что изменилось</a>
    </div>
  </div>
  <Header active={active} />
  <main id="main"><slot /></main>
  <Footer />
  <script>
    import { initRequest } from '../lib/request';
    initRequest();
  </script>
</body>
</html>

<style>
  .concept-bar { background: var(--tag); color: var(--ink); font-size: 0.85rem; }
  .concept-bar .wrap { display: flex; gap: 16px; justify-content: space-between; align-items: center; min-height: 36px; padding-top: 6px; padding-bottom: 6px; }
  .concept-bar a { color: var(--ink); font-weight: 600; white-space: nowrap; }
</style>
