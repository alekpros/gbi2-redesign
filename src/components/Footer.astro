---
import { company, nav } from '../data/site';
import { u } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="f-name">{company.name}</p>
      <p>{company.address}</p>
      <p><a href={company.mapUrl} rel="noopener">Открыть на Яндекс Картах</a></p>
    </div>
    <div>
      <p class="f-label">Отдел сбыта</p>
      <p><a class="f-phone" href={company.sales.href}>{company.sales.label}</a><br /><a href={`mailto:${company.sales.email}`}>{company.sales.email}</a></p>
      <p class="f-label">Приёмная</p>
      <p><a href={company.phone.href}>{company.phone.label}</a><br /><a href={`mailto:${company.email}`}>{company.email}</a></p>
    </div>
    <nav aria-label="Разделы в подвале">
      <ul>
        {nav.map((n) => <li><a href={u(n.href)}>{n.label}</a></li>)}
        <li><a href={u('price-list/')}>Прайс-лист</a></li>
        <li><a href={u('about/#documents')}>Документы и СОУТ</a></li>
        <li><a href={u('about/#requisites')}>Реквизиты</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <span>© 1956–{year} {company.short}</span>
    <a href={u('privacy/')}>Политика обработки персональных данных</a>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #cfd3d0; padding: 56px 0 28px; font-size: 0.95rem; }
  .site-footer a { color: #fff; }
  .grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 32px; }
  .f-name { color: #fff; font-weight: 600; }
  .f-label { margin: 0 0 2px; color: #9aa19d; font-size: 0.85rem; }
  .f-phone { font: 600 1.3rem/1.3 var(--display); text-decoration: none; }
  ul { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 24px; }
  li { margin-bottom: 8px; break-inside: avoid; }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 40px; padding-top: 20px; border-top: 1px solid #3a4246; font-size: 0.85rem; color: #9aa19d; }
  .legal a { color: #9aa19d; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
