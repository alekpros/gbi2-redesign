---
import Base from '../layouts/Base.astro';
import { construction } from '../data/site';
import { u, img } from '../lib/url';
---
<Base title="Домостроение: панельно-кирпичные дома и каркас 1.020-1/87" active="construction/">
  <section class="page-head graph">
    <div class="wrap">
      <ul class="crumbs"><li><a href={u()}>Главная</a></li><li>Домостроение</li></ul>
      <h1>Домостроение</h1>
      <p class="lead">Завод проектирует и строит жильё из собственных изделий с 2004 года. Своя панельно-кирпичная серия, сборный каркас для общественных и промышленных зданий, товарный бетон.</p>
    </div>
  </section>
  <div class="wrap list">
    {construction.map((c, i) => (
      <section class:list={['row', { flip: i % 2 === 1 }]} id={c.slug}>
        {c.image ? <img src={img(c.image)} alt={c.title} loading="lazy" width="860" height="573" /> : <div class="noimg" aria-hidden="true"><span class="mark">Бетон</span><span class="mark">Раствор</span></div>}
        <div>
          <h2>{c.title}</h2>
          <p>{c.text}</p>
          {c.facts.length > 0 && <ul>{c.facts.map((f) => <li>{f}</li>)}</ul>}
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  .list { padding: 24px 0 80px; }
  .row { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 40px 0; border-bottom: 1px solid var(--rule); }
  .row.flip img, .row.flip .noimg { order: 2; }
  .row img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .row h2 { margin-bottom: 14px; }
  .row ul { padding-left: 18px; color: var(--ink-soft); }
  .noimg { aspect-ratio: 3 / 2; background: var(--concrete); display: flex; gap: 10px; align-items: center; justify-content: center; font-size: 1.8rem; }
  @media (max-width: 820px) { .row { grid-template-columns: 1fr; gap: 20px; } .row.flip img, .row.flip .noimg { order: 0; } }
</style>
